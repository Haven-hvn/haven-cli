{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom"],
    "allowJs": false
  },
  "tasks": {
    "start": "deno run --allow-all main.ts",
    "dev": "deno run --allow-all --watch main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-all"
  },
  "imports": {
    "@filoz/synapse-sdk": "npm:@filoz/synapse-sdk@2.0.2",
    "@filoz/synapse-core": "npm:@filoz/synapse-core@0.10.0",
    "ethers": "npm:ethers@6.17.0",
    "filecoin-pin": "npm:filecoin-pin@2.1.1",
    "multiformats/cid": "npm:multiformats@14.0.5/cid",
    "viem": "npm:viem@2.56.9"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }
}
