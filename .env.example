# Haven CLI environment variables
# Copy to .env and fill in real values. All HAVEN_* vars override config.toml.

# ============================================================================
# Blockchain network
# ============================================================================
HAVEN_NETWORK_MODE=testnet                      # testnet | mainnet
HAVEN_FILECOIN_NETWORK_MODE=                    # override (optional)
HAVEN_ARKIV_NETWORK_MODE=                       # override (optional)
HAVEN_FILECOIN_RPC_OVERRIDE=                    # override Filecoin RPC (optional)
HAVEN_ARKIV_RPC_OVERRIDE=                       # override Arkiv RPC (optional)

# ============================================================================
# ICP / Haven-AOL canister
# ============================================================================
HAVEN_ICP_HOST=https://icp-api.io
HAVEN_ICP_IDENTITY_PEM_PATH=/path/to/identity.pem
HAVEN_AOL_CANISTER_ID=3gzy3-kaaaa-aaaan-q6y6q-cai
HAVEN_ICP_VERIFY_CERTIFICATE=false
HAVEN_ICP_MAX_RETRIES=3
HAVEN_ICP_RETRY_BASE_DELAY=1.0

# EVM / Haven-AOL gate signing
HAVEN_PRIVATE_KEY=0x...
HAVEN_AOL_EIP712_CHAIN_ID=1                    # 1 mainnet, 11155111 sepolia
HAVEN_AOL_EIP712_VERIFYING_CONTRACT=0x...


# ============================================================================
# Pipeline - VLM
# ============================================================================
HAVEN_VLM_ENABLED=true
HAVEN_VLM_MODEL=zai-org/glm-4.6v-flash
HAVEN_VLM_API_KEY="your-openai-api-key-here"
HAVEN_VLM_TIMEOUT=70.0
HAVEN_VLM_ANALYSIS_TAGS=person,car,bicycle,motorcycle,airplane,bus,train,truck,boat

# ============================================================================
# Debug
# ============================================================================
DEBUG=0
LOG_LEVEL=INFO

