# ============================================================================
# haven-cli Environment Variables
# Copy this to .env and fill in your values
# ============================================================================

# ============================================================================
# HAVEN_PRIVATE_KEY (REQUIRED for everything blockchain-related)
# ============================================================================
# Your EVM private key (with or without 0x prefix).
# This single key is used for:
#   - Synapse SDK authentication / Filecoin uploads
#   - Arkiv blockchain transactions (entity creation + gas fees)
#   - EIP-712 signature for Haven-AOL gate encryption requests
#   - Attestation signing (proving token holding to the canister)
#
# Get a wallet: MetaMask, etc.
# Fund it with: tFIL (Filecoin Calibration), ETH/GLM (Arkiv Braga testnet),
#               and the native token of whatever EVM chain your gate token is on
env:HAVEN_PRIVATE_KEY="0xYOUR_EVM_PRIVATE_KEY_HERE"

# ============================================================================
# ICP IDENTITY (REQUIRED for encryption)
# ============================================================================
# Path to your Internet Computer identity PEM file.
# Must be a NON-ANONYMOUS identity.
#
# Generate a new identity:
#   1. Install dfx: https://internetcomputer.org/docs/current/developer-docs/getting-started/quickstart/dfx-install
#   2. dfx new my_project
#   3. dfx identity list
#   4. dfx identity export <identity_name> > identity.pem
#   5. Copy the PEM content to a permanent location
#
# The canister IDENTITY_PEM_PATH will be used with:
#   Identity.from_pem(pem_content)
# See: https://github.com/dfinity/agent-js/tree/main/packages/identity
env:HAVEN_ICP_IDENTITY_PEM_PATH="C:\Users\User\.config\haven\identity.pem"

# ============================================================================
# ICP API HOST (optional, default shown)
# ============================================================================
# The ICP boundary node URL for canister calls.
# Default is https://icp-api.io (mainnet)
#env:HAVEN_ICP_HOST="https://icp-api.io"

# ============================================================================
# ICP Certificate Verification (optional)
# ============================================================================
# Set to 1/true to verify IC certificates on update calls.
# Requires the `blst` Python package (hard to install on Windows).
# Default: false (most people leave this off)
#env:HAVEN_ICP_VERIFY_CERTIFICATE="0"

# ============================================================================
# ICP Retry Settings (optional)
# ============================================================================
# Max retries for transient ICP HTTP errors (default: 3)
#env:HAVEN_ICP_MAX_RETRIES="3"
# Base delay in seconds for exponential backoff (default: 1.0)
#env:HAVEN_ICP_RETRY_BASE_DELAY="1.0"

# ============================================================================
# EIP-712 DOMAIN PARAMETERS (REQUIRED for encryption)
# ============================================================================
# These define the EIP-712 signature domain for the Haven-AOL canister's
# requestDecryptionKey call. The will verify the EIP-712 signature you send,
# and these values must EXACTLY match what the canister expects.
#
# Contact the canister deployer or check the canister source to find these.
# Canister: dciac-uaaaa-aaaad-qlzuq-cai (ICP mainnet)
#
# The verifying contract is an EVM contract address used in the EIP-712 domain.
# The chain_id is the EVM chain ID (e.g., 1 for Ethereum mainnet, 11155111 for Sepolia)
env:HAVEN_AOL_EIP712_CHAIN_ID="1"
env:HAVEN_AOL_EIP712_VERIFYING_CONTRACT="0xYOUR_VERIFYING_CONTRACT_ADDRESS"

# ============================================================================
# VETKD TRANSPORT KEYPAIR (REQUIRED for encryption/decryption)
# ============================================================================
# Generate these yourself using vetkd_py. Run this Python script once:
#
#   import vetkd_py, base64
#   secret = vetkd_py.generate_transport_secret_key()
#   public = vetkd_py.transport_public_key_from_secret(secret)
#   print("HAVEN_AOL_TRANSPORT_SECRET_KEY_B64=" + base64.b64encode(secret).decode())
#   print("HAVEN_AOL_TRANSPORT_PUBLIC_KEY_B64=" + base64.b64encode(public).decode())
#
# vetkd_py install: cd vetkd_py && pip install -e .
# The transport keypair is an Ed25519 keypair used to unwrap the canister's
# encrypted response during both encryption and decryption.
env:HAVEN_AOL_TRANSPORT_SECRET_KEY_B64="GENERATE_WITH_VETKD_PY"
env:HAVEN_AOL_TRANSPORT_PUBLIC_KEY_B64="GENERATE_WITH_VETKD_PY"

# ============================================================================
# NETWORK MODE (optional, default: testnet)
# ============================================================================
# Sets BOTH Filecoin and Arkiv RPC endpoints.
#   testnet = Filecoin Calibration + Arkiv Braga (recommended for testing)
#   mainnet = Filecoin Mainnet + Arkiv Mainnet (real tokens!)
#
# Default Filecoin RPCs:
#   testnet: wss://wss.calibration.node.glif.io/apigw/lotus/rpc/v1
#   mainnet: wss://wss.node.glif.io/apigw/lotus/rpc/v1
#
# Default Arkiv RPCs:
#   testnet: https://braga.hoodi.arkiv.network/rpc
#   mainnet: https://mainnet.arkiv.network/rpc
env:HAVEN_NETWORK_MODE="testnet"

# ============================================================================
# FILECOIN RPC OVERRIDE (optional)
# ============================================================================
# Override the default Filecoin RPC URL derived from HAVEN_NETWORK_MODE.
# Only needed if you're running your own Filecoin node.
#env:FILECOIN_RPC_URL="wss://wss.calibration.node.glif.io/apigw/lotus/rpc/v1"

# ============================================================================
# ARKIV RPC OVERRIDE (optional)
# ============================================================================
# Override the default Arkiv RPC URL derived from HAVEN_NETWORK_MODE.
# Only needed if you have a custom Arkiv node.
#env:ARKIV_RPC_URL="https://braga.hoodi.arkiv.network/rpc"

# ============================================================================
# ARKIV SYNC ENABLED (optional)
# ============================================================================
# Enable/disable Arkiv blockchain sync. Also controlled by pipeline.sync_enabled in config.toml.
#env:ARKIV_SYNC_ENABLED="true"

# ============================================================================
# ARKIV EXPIRATION (optional)
# ============================================================================
# Arkiv entity expiration in weeks (default: 4).
#env:ARKIV_EXPIRATION_WEEKS="4"

# ============================================================================
# VLM ANALYSIS (optional, for AI-powered video analysis)
# ============================================================================
# API key for VLM analysis. Only needed if pipeline.vlm_enabled = true.
# Supports OpenAI or any OpenAI-compatible endpoint.
#env:HAVEN_VLM_API_KEY="sk-your-openai-api-key"

# ============================================================================
# CONFIG/DATA DIRECTORY OVERRIDES (optional)
# ============================================================================
# Override default config directory (default: ~/.config/haven)
#env:HAVEN_CONFIG_DIR="C:\Users\User\.config\haven"
# Override default data directory (default: ~/.local/share/haven)
#env:HAVEN_DATA_DIR="C:\Users\User\.local\share\haven"

# ============================================================================
# DATABASE URL (optional)
# ============================================================================
# Override default SQLite database location.
# Default: sqlite:///~/.local/share/haven/haven.db
#env:HAVEN_DATABASE_URL="sqlite:///C:/Users/User/.local/share/haven/haven.db"

# ============================================================================
# LOG LEVEL (optional)
# ============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO via config.toml)
#env:HAVEN_LOG_LEVEL="DEBUG"

# ============================================================================
# JS RUNTIME (optional)
# ============================================================================
# JavaScript runtime for Synapse SDK bridge: "deno", "node", or "auto" (default: deno)
#env:HAVEN_JS_RUNTIME="deno"
# Enable JS runtime debug mode
#env:HAVEN_JS_DEBUG="false"